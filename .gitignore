# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captured folder for screenshots
captures/

# Keystore files
*.jks
*.keystore
*.p12
*.pem

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# OS generated files
.DS_Store
Thumbs.db

# Log files
*.log

# Coverage reports (excluded from tracking but not from gitignore patterns)
**/reports/
**/build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Version control
.svn/

# Bundletool
bundletool-*.jar

# Kotlin compiler
.kotlin/

# Node
node_modules/
